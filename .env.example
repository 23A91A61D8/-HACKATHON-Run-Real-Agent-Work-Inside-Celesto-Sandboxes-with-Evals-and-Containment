# Celesto sandbox provider: local or cloud
CELESTO_PROVIDER=cloud

# Celesto Cloud API key (get from https://celesto.ai Settings -> Security)
CELESTO_API_KEY=replace-me

# Celesto backend type (firecracker for microVM isolation)
CELESTO_BACKEND=firecracker

# LLM provider base URL (OpenAI-compatible endpoint)
LLM_BASE_URL=https://example-llm-host/v1

# LLM API key
LLM_API_KEY=replace-me

# LLM model name to use
LLM_MODEL=replace-with-a-model-name

# PostgreSQL connection string (auto-configured by docker-compose)
DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger

# Port for the API service
API_PORT=8080

# Maximum wall-clock seconds per sandbox run before timeout
SANDBOX_TIMEOUT_S=120

# Maximum number of concurrent sandboxes (trial: 1, paid: up to 10)
MAX_CONCURRENT_SANDBOXES=5

# Agent step count (10 steps per grading pipeline)
AGENT_TOTAL_STEPS=10

# Whether to delete sandboxes on success (true/false)
DELETE_ON_SUCCESS=true
